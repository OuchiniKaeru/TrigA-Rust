# Rust / Cargo
target/
**/*.rs.bk

# Tauri
src-tauri/gen/schemas/
src-tauri/*.log
*.AppImage
*.dmg
*.msi
*.exe
*.deb
*.rpm

# Runtime data (SQLite lives in the OS user-data dir; TRIGA_DATA_DIR overrides it.
# Never keep a live database under a source tree: `cargo tauri dev` watches
# src-tauri/ and kills the app on every save when the DB is written there.)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite*
src-tauri/data/
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Node (JS tests run with `node --test`)
node_modules/
coverage/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
docs/

# Env
.env
.env*.local
